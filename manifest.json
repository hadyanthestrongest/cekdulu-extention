{
  "manifest_version": 3,
  "name": "CekDulu",
  "version": "0.1.0",
  "description": "CekDulu: biar nggak kepancing. Mencari tanda situs penipuan langsung di browsermu, tanpa mengirim data ke mana pun.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "CekDulu",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["rules.js", "brand.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
